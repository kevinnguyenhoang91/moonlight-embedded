## Moonlight Embedded settings. Copied to moonlight.conf on first launch;
## edit moonlight.conf (not this file), it is kept when the port is updated.

## IP address or hostname of the PC running Sunshine.
## Leave unset to auto-discover the PC on the local network (mDNS).
#address = 192.168.1.50

## App to start, exactly as named in Sunshine (e.g. Desktop, Steam Big Picture).
app = Desktop

## Stream resolution. Default is the device's native screen resolution
## (960x720 on the MiniLoong Pocket 1, 720x720 on the RGB20SX).
## Uncomment one of these to override:
#960x720 = true
#width = 720
#height = 720

## Frames per second.
fps = 60

## Bitrate in kbps. Default (-1) is 10000 for 960x720 at 60 fps.
#bitrate = 8000

## Video codec: h264 is the cheapest to decode in software on RK3566.
codec = h264

## Quit the app on the PC when the stream ends.
#quitappafter = true

## Optimize for remote (internet) streaming: yes / no / auto.
#remote = auto

## Play audio on the PC instead of the handheld.
#localaudio = true
